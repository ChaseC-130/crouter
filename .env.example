# Server only. Set locally; never commit .env.local.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Local private runtime storage. Prefer a directory outside any source repository.
# CROUTER_DATA_DIR=/absolute/private/directory/crouter
# Exact loopback origin; must match the port used by Next.js.
CROUTER_ORIGIN=http://127.0.0.1:3000
# Optional absolute CLI paths if they aren't on PATH.
CODEX_BIN=codex
CLAUDE_BIN=claude
# Read-only workers time out after this many milliseconds (10s–10m).
WORKER_TIMEOUT_MS=120000
# Synthetic demo uses no network and never starts a provider CLI.
CROUTER_DEMO=0
GROK_BIN=grok
# These additional adapters currently require macOS sandbox-exec.
GEMINI_BIN=gemini
AGY_BIN=agy
MUSE_BIN=muse
# Optional PRIVATE Tailscale Serve ingress. Keep Next bound to 127.0.0.1.
# Enabling this requires a permitted Serve identity for EVERY API request.
# CROUTER_TAILSCALE_ORIGIN=https://device.tailnet.ts.net
# CROUTER_TAILSCALE_USERS=your-tailnet-login
